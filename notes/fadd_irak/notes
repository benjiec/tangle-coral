
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF01335 --taxon anthozoa -o res-pf01335.faa

# manually inspect remaining sequences and remove those that do not look like
# DED-DD-PKinase, and remove duplicates from same locus, save into
# cn_FADD-IRAK.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf01335.faa cn_FADD-IRAK.txt > cn_FADD-IRAK.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_FADD-IRAK.faa -out /app/FADD-IRAK_anthozoa.msa

hmmbuild FADD-IRAK_anthozoa.hmm FADD-IRAK_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm FADD-IRAK_anthozoa.hmm \
  --positive-fasta cn_FADD-IRAK.faa \
  --all-fasta res-pf01335.faa \
  --output x
