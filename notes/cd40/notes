
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00020 --taxon homo -o res-pf00020_hs.faa
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00020 --taxon anthozoa -o res-pf00020.faa

cat res-pf00020_hs.faa res-pf00020.faa > x.faa
docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/x.faa /work/candidates /tmp
echo "Cluster Repr\tCluster Member" | cat - candidates_cluster.tsv > candidates_cluster.tsv.h
mv candidates_cluster.tsv.h candidates_cluster.tsv
rm x.faa

cut -f 2 candidates_cluster.tsv | grep -v "_K" | grep -v "Cluster Member" | sieve-py ~/git/tangle/sieve/scripts/protein-names.py - > candidate_names.tsv

sieve-py motifs.py res-pf00020.faa - > candidate_motifs.tsv
sieve-py motifs.py res-pf00020_hs.faa - | grep -v detection_type >> candidate_motifs.tsv

# make 4 .faa files for submisson to DeepTHHMM, no _K sequences, max 250 sequences each file
# include both _hs references and anthozoa sequences

sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth1.3line - > candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth2.3line - | grep -v detection_method >> candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth3.3line - | grep -v detection_method >> candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth4.3line - | grep -v detection_method >> candidate_deeptm.tsv

