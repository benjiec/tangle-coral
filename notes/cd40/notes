
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00020 --taxon homo -o res-pf00020_hs.faa
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00020 --taxon anthozoa -o res-pf00020.faa

sieve-py ~/git/tangle/sieve/scripts/fasta-unique-sequences.py res-pf00020.faa z 
mv z res-pf00020.faa

cat res-pf00020_hs.faa res-pf00020.faa > x.faa
docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/x.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv
rm x.faa

cut -f 2 candidate_cluster.tsv | grep -v "_K" | grep -v "Cluster Member" | sieve-py ~/git/tangle/sieve/scripts/protein-names.py - > candidate_names.tsv

sieve-py motifs.py res-pf00020.faa - > candidate_motifs.tsv
sieve-py motifs.py res-pf00020_hs.faa - | grep -v detection_type >> candidate_motifs.tsv

# make 4 .faa files for submisson to DeepTHHMM, no _K sequences, max 250 sequences each file
# include both _hs references and anthozoa sequences

sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth1.3line - > candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth2.3line - | grep -v detection_method >> candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth3.3line - | grep -v detection_method >> candidate_deeptm.tsv
sieve-py ~/git/tangle/sieve/scripts/deeptm-to-detected.py dth4.3line - | grep -v detection_method >> candidate_deeptm.tsv

# get inside sequence
sieve-py ~/git/tangle/sieve/scripts/detected-extract-region.py \
  res-pf00020.faa candidate_deeptm.tsv inside 1 1 candidate_inside.faa
sieve-py ~/git/tangle/sieve/scripts/detected-extract-region.py \
  res-pf00020_hs.faa candidate_deeptm.tsv inside 1 1 candidate_inside_hs.faa
cat candidate_inside.faa candidate_inside_hs.faa > z
mv z candidate_inside.faa
rm candidate_inside_hs.faa

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/candidate_inside.faa /work/candidate_inside /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_inside_cluster.tsv > candidate_inside_cluster.tsv.h
mv candidate_inside_cluster.tsv.h candidate_inside_cluster.tsv
rm candidate_inside_*.fasta
