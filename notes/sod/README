  --rule coral.rules.sp_MnSOD_cnidaria.rule_tangle_curated \
  --artifacts-dir res-sp_MnSOD_cnidaria \
  --pfam-hmm assets/pfam.hmm \
  --ko-hmm assets/k04564.hmm \
  --ko-thresholds assets/k04564_threshold.tsv \
