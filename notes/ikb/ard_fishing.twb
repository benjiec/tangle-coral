    <worksheet name='Hits above KO thresholds'>
      <table>
        <view>
          <datasources>
            <datasource caption='ard_fishing+' name='federated.1hwqt6w1y66l6615kq3ll13ohdd7' />
          </datasources>
          <datasource-dependencies datasource='federated.1hwqt6w1y66l6615kq3ll13ohdd7'>
            <column datatype='real' name='[A_265-405_C_all_pDockQ2_max]' role='measure' type='quantitative' />
            <column datatype='real' name='[B_265-405_C_all_pDockQ2_max]' role='measure' type='quantitative' />
            <column caption='HMM Detected' datatype='boolean' name='[Calculation_5482482924261376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([target name],&quot;_K&quot;)' />
            </column>
            <column caption='C pDockQ2 max' datatype='real' name='[Calculation_5901878298152974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([A_265-405_C_all_pDockQ2_max],[B_265-405_C_all_pDockQ2_max])' />
            </column>
            <column caption='Thresholds' datatype='real' name='[Calculation_5901878635122709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [query name (cn_RHD-binding.ko.tsv)]&#10;WHEN &quot;K04734&quot; THEN 288.83&#10;WHEN &quot;K02581&quot; THEN 284.3&#10;WHEN &quot;K05872&quot; THEN 310.4&#10;WHEN &quot;K09258&quot; THEN 297.53&#10;END' />
            </column>
            <column caption='Above threshold' datatype='boolean' name='[Calculation_5901878635991062]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[seq score (cn_RHD-binding.ko.tsv)] &gt;= [Calculation_5901878635122709]' />
            </column>
            <column caption='Has KO assignment' datatype='boolean' name='[Calculation_5901878637297687]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [target name]: MAX([Calculation_5901878635991062])}' />
