            <column caption='Locus Type' datatype='string' name='[Calculation_1429412292603913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [locus_id]: IFNULL(&#10;  CASE MAX([Tree Group])&#10;  WHEN &quot;Group 4.4&quot; THEN &quot;IkBa-like&quot;&#10;  WHEN &quot;Group 2.4&quot; THEN &quot;IkB-like-2&quot;&#10;  WHEN &quot;Group 1.4&quot; THEN &quot;IkB-like-1&quot; END,&#10;MAX([Type]))}' />
            </column>
            <column caption='Transcript Max Score' datatype='real' name='[Calculation_1429412292837386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [transcript_id]: MAX([score])}' />
            </column>
            <column caption='Is Max Score' datatype='boolean' name='[Calculation_1429412293005323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1429412292837386] == [score]' />
            </column>
            <column caption='Coral Host' datatype='string' name='[Calculation_1429412297523213]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([query name], &quot;a_tenuis&quot;)&#10;THEN &quot;a_tenuis&quot;&#10;ELSE SPLIT([query name], &quot;_&quot;, 1)&#10;END' />
            </column>
            <column caption='Correct Locus' datatype='boolean' name='[Calculation_5230974582837250]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1429412293005323] AND [score] &gt;= 80' />
