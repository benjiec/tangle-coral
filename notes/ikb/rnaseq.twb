              <calculation class='tableau' formula='IF CONTAINS([locus_id],&quot;_cnidaria_&quot;)&#10;THEN &quot;HMM_&quot;+REGEXP_EXTRACT([locus_id], &quot;_cnidaria_([^_]+)_&quot;)&#10;ELSE SPLIT([locus_id], &quot;_cds&quot;, 1)&#10;END' />
