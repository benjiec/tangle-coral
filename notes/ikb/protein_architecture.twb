      <column caption='Max Protein Match Coord' datatype='integer' name='[Ank PF00023 Repeats (copy)_1507335362695170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [query_accession]: MAX(&#10;[query_end (protein_pfam.tsv1)]&#10;)}' />
      </column>
      <column caption='Lowest E-value Rank' datatype='integer' name='[Calculation_0036393756078080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [query_accession (protein_ko_assigned.tsv)],&#10;       [query_database (protein_ko_assigned.tsv)]: MIN(&#10;&#10;IF [bitscore (protein_ko_assigned.tsv)] &gt;= [bitscore_threshold (protein_ko_assigned.tsv)]&#10;THEN INT([custom_metric_value (protein_ko_assigned.tsv)])&#10;ELSE NULL END&#10;)}' />
      </column>
      <column caption='Min Pfam Start' datatype='integer' name='[Calculation_0858897303928835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [query_accession]: MIN([query_start (protein_pfam.tsv1)])}' />
      </column>
      <column caption='Match Length' datatype='integer' name='[Calculation_1310520663515136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[query_end (protein_pfam.tsv1)]-[query_start (protein_pfam.tsv1)]+1' />
      </column>
      <column caption='Assigned KO' datatype='string' name='[Calculation_1318698290372608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [query_accession],[query_database]: MAX(&#10;&#10;IF INT([custom_metric_value (protein_ko_assigned.tsv)]) == [Calculation_0036393756078080]&#10;THEN [target_accession (protein_ko_assigned.tsv)]&#10;ELSE NULL END&#10;&#10;)}' />
      </column>
      <column caption='Ank PF00023 Repeats' datatype='integer' name='[Calculation_1507335361929216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [query_accession],[query_database]: SUM(&#10;&#10;IF LEFT([target_accession (protein_pfam.tsv1)],7) == &quot;PF00023&quot; THEN 1 ELSE 0 END&#10;&#10;)}' />
      </column>
      <column caption='Cluster Size' datatype='integer' name='[Calculation_1507335631474691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Cluster Repr]: COUNTD([Cluster Member])}' />
      </column>
      <column caption='Avg Protein Length diff from Ideal' datatype='real' name='[Calculation_1507335720837124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Cluster Repr]:&#10;ABS(AVG([Ank PF00023 Repeats (copy)_1507335362695170])-400)}' />
      </column>
