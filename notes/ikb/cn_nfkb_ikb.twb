              <calculation class='tableau' formula='{FIXED [protein accession]:&#10;  IFNULL(MAX([Type]),&#10;    IFNULL(MAX([Type (needle_curated.tsv)]),&#10;         CASE LEFT(MAX([Tree Group]),7)&#10;           WHEN &quot;Group 1&quot; THEN &quot;IkB-like-1&quot;&#10;           WHEN &quot;Group 2&quot; THEN &quot;IkB-like-2&quot;&#10;           WHEN &quot;Group 3&quot; THEN &quot;C-term tail of p105-like&quot;&#10;           WHEN &quot;Group 4&quot; THEN &quot;IkBa-like&quot;&#10;         END))&#10;}' />
