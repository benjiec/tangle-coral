      <aliases enabled='yes' />
      <column caption='Match Length' datatype='integer' name='[Calculation_1665186084921345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[query_end]-[query_start]+1' />
      </column>
      <column caption='Signals (Short)' datatype='string' name='[Calculation_1665186342486018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#10;  REPLACE([Signals],&quot;Nuclear export signal&quot;,&quot;NES&quot;),&#10;  &quot;Nuclear localization signal&quot;, &quot;NLS&quot;&#10;)' />
      </column>
      <column caption='Protein Signal' datatype='string' name='[Calculation_1665186343124995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [protein accession]: IFNULL(MAX([Calculation_1665186342486018]), &quot;&quot;)}' />
      </column>
      <column caption='Rel TF Motif' datatype='string' name='[Calculation_1665186344370180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [TFMotifs.has(&apos;GM.5.0.Rel&apos;, min_score_threshold=None, fpr=0.01).between(-1500, 500)]&#10;WHEN &quot;yes&quot;&#10;  THEN &quot;Rel Motif&quot;&#10;ELSE&#10;  &quot;&quot;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Protein Gene Locus  Left' datatype='integer' name='[Calculation_1665186374017030]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [protein accession],[contig accession]: MIN(MIN([locus start 1b],[locus end 1b]))}' />
      </column>
      <column caption='Protein Type' datatype='string' name='[Calculation_1665186807808014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [protein accession]:&#10;  IFNULL(MAX([Type]),&#10;    IFNULL(MAX([Type (needle_curated.tsv)]),&#10;         CASE LEFT(MAX([Tree Group]),7)&#10;           WHEN &quot;Group 1&quot; THEN &quot;IkB-like-1&quot;&#10;           WHEN &quot;Group 2&quot; THEN &quot;IkB-like-2&quot;&#10;           WHEN &quot;Group 3&quot; THEN &quot;C-term tail of p105-like&quot;&#10;           WHEN &quot;Group 4&quot; THEN &quot;IkBa-like&quot;&#10;         END))&#10;}' />
      </column>
      <column caption='IkB Group' datatype='string' name='[Calculation_1665186884837391]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [protein accession]: MAX([Tree Group])}' />
      </column>
      <column caption='Protein Accession Short' datatype='string' name='[Calculation_5488396015345664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([protein accession],&quot;_cnidaria_&quot;)&#10;THEN &quot;HMM_&quot;+RIGHT([protein accession], 8)&#10;ELSE [protein accession]&#10;END' />
      </column>
      <column caption='Genome Accession1' datatype='string' name='[Genome Accession]' role='dimension' type='nominal' />
      <column caption='Protein Accession1' datatype='string' name='[Protein Accession]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Protein Gene Locus Right' datatype='integer' name='[Protein Gene Locus  Left (copy)_1665186374324231]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [protein accession],[contig accession]: MAX(MAX([locus start 1b],[locus end 1b]))}' />
      </column>
      <column caption='Protein Cytoplasm Localization Score' datatype='real' name='[Protein Nucleus Localization Score (copy)_1665186790735885]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [protein accession]: MAX([Cytoplasm])}' />
      </column>
      <column caption='Locus Rel Motif' datatype='string' name='[Protein Signal (copy)_1665186344824837]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [protein accession]: IFNULL(MAX([Calculation_1665186344370180]), &quot;&quot;)}' />
      </column>
      <column caption='Protein Nucleus Localization Score' datatype='real' name='[Protein Signal (copy)_1665186790305803]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [protein accession]: MAX([Nucleus])}' />
      </column>
