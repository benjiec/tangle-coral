# Various references
sieve-py ../sieve/scripts/ko-find-matches.py K04734 --taxon "Homo sapiens" -o hs_K04734.faa
sieve-py ../sieve/scripts/ko-find-matches.py K02581 --taxon "Homo sapiens" -o hs_K02581.faa
sieve-py ../sieve/scripts/ko-find-matches.py K05872 --taxon "Homo sapiens" -o hs_K05872.faa 
sieve-py ../sieve/scripts/ko-find-matches.py K09258 --taxon "Homo sapiens" -o hs_K09258.faa 


# Find ARD containing sequences to cluster then binding check on AF

sieve-py ../sieve/scripts/pfam-find-matches.py PF12796 --taxon cnidaria |
  PYTHONPATH=../coral python3 ../sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.IkB_cnidaria.permissive_ard_rule \
    --artifacts-dir res-ank-permissive

PYTHONPATH=../coral python3 ../sieve/scripts/check-artifacts-by-rules.py \
  --rule coral.rules.IkB_cnidaria.permissive_ard_rule \
  --artifacts-dir res-ank-permissive \
  --cpus 8 \
  --pfam-hmm assets/Pfam-A.hmm

../sieve/scripts/rule-results-to-fasta.py \
  --artifacts-dir res-ank-permissive \
  --output cn_ank.faa

# Cluster
docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/cn_ank.faa /work/cn_ank /tmp
echo "Cluster Repr\tCluster Member" | cat - cn_ank_cluster.tsv > cn_ank_cluster.tsv.h; mv cn_ank_cluster.tsv.h cn_ank_cluster.tsv
# Use repr sequences to run on AF to screen for RHD binding sequences

# Scoring the AF models, with .zip files in nv-folds/, and assuming multi-mer mode
# with two copies of Nv p50, and single copy of candidate as chain C
#
../sieve/scripts/alphafold-pdockq2-directory.py \
  nv-folds/ \
  --region A:265-405 \
  --region B:265-405 \
  --output alphafold_docking_scores.txt

# Download top hits from Tableau into cn_RHD-binding.txt


# Fishing for more sequences, then assess hits against KO
python3 ../tangle/scripts/fasta-emit.py res-ank-permissive/input.faa cn_RHD-binding.txt > cn_RHD-binding.faa
../sieve/scripts/pfam-extract-region.py cn_RHD-binding.faa protein_pfam.tsv PF12796 1 5 cn_RHD-binding_ARD.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_RHD-binding_ARD.faa -out /app/cn_RHD-binding_ARD.msa
hmmbuild cn_RHD-binding_ARD.hmm cn_RHD-binding_ARD.msa
hmmsearch --domtblout x cn_RHD-binding_ARD.hmm res-ank-permissive/input.faa
python3 ../sieve/scripts/domtbl-tsv.py x > ard_fishing.tsv
hmmsearch --domtblout x ko_ikb.hmm cn_RHD-binding.faa
python3 ../sieve/scripts/domtbl-tsv.py x > cn_RHD-binding.ko.tsv

# Submit cn_RHD-binding.faa to DeepLoc, save results to
# cn_RHD-binding.deeploc.csv

touch cn_RHD-binding.deeploc.csv


# Generate a candidate list, based on AF scores, of all sequences that either
# passed AF thresholds or are likely to, save to cn_candidates.txt

# Combine cn_candidates.txt and p105-like and p50-like sequences from nfkb work
# into a single cn_nfkb_and_ikb.txt file. Also create a cn_p105_p50.txt sequence list.

# Generate a loci list for both NFkB and IkB proteins
grep -F -f cn_nfkb_and_ikb.txt /Volumes/Extreme_Pro/areas/coral/genomics/sequences.tsv | cut -f1,2 |
  PYTHONPATH=../coral python3 ../sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.IkB_cnidaria.kb_rule \
    --artifacts-dir res-nfkb-ikb
cp res-nfkb-ikb/genomic_loci.tsv cn_nfkb_and_ikb_loci.tsv 

PYTHONPATH=../coral python3 ../sieve/scripts/check-artifacts-by-rules.py \
  --rule coral.rules.IkB_cnidaria.kb_rule \
  --artifacts-dir res-nfkb-ikb
cp res-nfkb-ikb/rule-results.tsv cn_nfkb_ikb.rules.tsv

# Generate .faa for DeepLoc, using candidates, but substitute truncated
# sequences for longer sequences. This is cn_ikb.deeploc.faa. Submit to
# DeepLoc and save outputs to cn_ikb.deeploc.csv

touch cn_ikb.deeploc.csv


# Generate worklist for intra-species AlphaFold screening
python3 cn_nfkb_and_ikb_pairs.py

# Use the generated cn_nfkb_and_ikb_pairs.faa to setup AF runs, with each run name like CAH3027709_1_CAH3197536_1

# Then use this to score them
python3 cn_nfkb_and_ikb_score.py


# Build a tree and save groups to cn_ikb_groups.txt
cp cn_ikb.deeploc.faa x.faa
# remove XP_065056061.1 from x.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/x.faa -out /app/x.msa
~/iqtree-3.1.3-macOS/bin/iqtree3 -s x.msa -B 1000 --alrt 1000
mv x.msa.contree cn_ikb_tree.contree


# Build a tree of ARD region
# cat cn_ikb.deeploc.faa and p105-like faa together, but now use non-truncated
# sequences rather than those in cn_truncations.faa, this creates ard_containing.faa

../sieve/scripts/pfam-extract-region.py ard_containing.faa protein_pfam.tsv PF12796 1 5 x.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/x.faa -out /app/x.msa
~/iqtree-3.1.3-macOS/bin/iqtree3 -s x.msa -B 1000 --alrt 1000
mv x.msa.contree cn_ikb_tree.contree


# Building profiles

# Note that cn_ikb.deeploc.faa should have truncated sequences where that's appropriate

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py cn_ikb.deeploc.faa group1 > IkB-like-1_cnidaria.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py cn_ikb.deeploc.faa group2 > IkB-like-2_cnidaria.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py cn_ikb.deeploc.faa group4 > IkBa-like_cnidaria.faa

cat IkB-like-1_cnidaria.faa IkB-like-2_cnidaria.faa IkBa-like_cnidaria.faa > cn_ikb_all.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/IkB-like-1_cnidaria.faa -out /app/IkB-like-1_cnidaria.msa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/IkB-like-2_cnidaria.faa -out /app/IkB-like-2_cnidaria.msa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/IkBa-like_cnidaria.faa -out /app/IkBa-like_cnidaria.msa

hmmbuild IkB-like-1_cnidaria.hmm IkB-like-1_cnidaria.msa
hmmbuild IkB-like-2_cnidaria.hmm IkB-like-2_cnidaria.msa
hmmbuild IkBa-like_cnidaria.hmm IkBa-like_cnidaria.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IkBa-like_cnidaria.hmm \
  --positive-fasta IkBa-like_cnidaria.faa \
  --all-fasta cn_ikb_all.faa \
  --output x_ikba

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IkB-like-1_cnidaria.hmm \
  --positive-fasta IkB-like-1_cnidaria.faa \
  --all-fasta cn_ikb_all.faa \
  --output x_ikb-1

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IkB-like-2_cnidaria.hmm \
  --positive-fasta IkB-like-2_cnidaria.faa \
  --all-fasta cn_ikb_all.faa \
  --output x_ikb-2
