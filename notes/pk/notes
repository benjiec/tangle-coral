
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00069 \
  --sequence-source ncbi \
  --taxon anthozoa \
  -o res-pf00069_an.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00069 \
  --sequence-source ncbi \
  --taxon homo \
  -o res-pf00069_hs.faa

cat res-pf00069_an.faa res-pf00069_hs.faa > res-pf00069.faa

sieve-py ~/git/tangle/sieve/scripts/detected-extract-region.py res-pf00069.faa protein_pfam.tsv PF00069 1 4 pk.faa --domain-only

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/res-pf00069.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/pk.faa /work/pk /tmp --min-seq-id 0.9 -c 0.9 --cov-mode 0
echo "Cluster Repr\tCluster Member" | cat - pk_cluster.tsv > pk_cluster.tsv.h
mv pk_cluster.tsv.h pk_cluster.tsv
