# TAK1

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00069 --taxon anthozoa -o res-pf00069.faa
sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K04427 --taxon anthozoa -o res-k04427.faa

# create cn_K04427_related.txt from Tableau, using it as positives and negatives
# removing clear truncations

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-k04427.faa cn_K04427_related.txt > cn_K04427.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf00069.faa cn_K04427_related.txt > cn_K04427_related.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_K04427.faa -out /app/TAK1_anthozoa.msa
hmmbuild TAK1_anthozoa.hmm TAK1_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm TAK1_anthozoa.hmm \
  --positive-fasta cn_K04427.faa \
  --all-fasta cn_K04427_related.faa \
  --output x


# TAB1

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00481 --taxon anthozoa -o res-pf00481.faa

grep ">" res-pf00481.faa | grep -v _K > cn_PF00481.txt
# remove leading ">" from cn_PF00481.txt

# create cn_K04403.txt from Tableau and remove isoforms and clear truncations
# also remove truncations from cn_PF00481.txt - just CAB3998147.1

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf00481.faa cn_K04403.txt > cn_K04403.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf00481.faa cn_PF00481.txt > cn_PF00481.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_K04403.faa -out /app/TAB1_anthozoa.msa
hmmbuild TAB1_anthozoa.hmm TAB1_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm TAB1_anthozoa.hmm \
  --positive-fasta cn_K04403.faa \
  --all-fasta cn_PF00481.faa \
  --output x


# TAB2/3

# cluster using itree pf02845 domain
# find tab2/3 cluster, filter those that are cnidaria
# confirm zf sequence on https://prosite.expasy.org/

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF02845 --match-only --taxon homo -o res-pf02845_domain_hs.faa
grep ">" res-pf02845_domain_hs.faa | grep -v _K > hs_PF02845_domain.txt
# remove leading ">" from hs_PF02845_domain.txt
# keep only NP_ sequences

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF02845 --match-only --taxon anthozoa -o res-pf02845_domain_cn.faa
grep ">" res-pf02845_domain_cn.faa | grep -v _K > cn_PF02845_domain.txt
# remove leading ">" from cn_PF02845_domain.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf02845_domain_cn.faa cn_PF02845_domain.txt > cn_PF02845_domain.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf02845_domain_hs.faa hs_PF02845_domain.txt > hs_PF02845_domain.faa

cat cn_PF02845_domain.faa hs_PF02845_domain.faa > cn_hs_PF02845_domain.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_hs_PF02845_domain.faa -out /app/cn_hs_PF02845_domain.msa
~/iqtree-3.1.3-macOS/bin/iqtree3 -s cn_hs_PF02845_domain.msa -B 1000 --alrt 1000

# from cluster generate cn_hs_K04404_K12793_cluster.txt and cn_K04404_K12793_cluster.txt

# prepare to make msa
sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K04404 --taxon homo -o res-k04404_hs.faa
sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K12793 --taxon homo -o res-k12793_hs.faa
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF02845 -o res-pf02845_all.faa
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF02845 --taxon anthozoa -o res-pf02845.faa

# generate msas and HMMs

# sequences less than 300 were removed from cn_K04404_K12793_cluster.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf02845.faa cn_K04404_K12793_cluster.txt > cn_TAB2.faa
cp cn_TAB2.faa cn_hs_TAB2.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-k04404_hs.faa cn_hs_K04404_K12793_cluster.txt >> cn_hs_TAB2.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-k12793_hs.faa cn_hs_K04404_K12793_cluster.txt >> cn_hs_TAB2.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_hs_TAB2.faa -out /app/cn_hs_TAB2.msa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_TAB2.faa -out /app/TAB2_3-like_anthozoa.msa
hmmbuild TAB2_3-like_anthozoa.hmm TAB2_3-like_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm TAB2_3-like_anthozoa.hmm \
  --positive-fasta cn_TAB2.faa \
  --all-fasta res-pf02845_all.faa \
  --output x



