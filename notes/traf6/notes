sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K03175 --taxon homo -o res-k03175_hs.faa
sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K09848 --taxon homo -o res-k09848_hs.faa
sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K10580 --taxon homo -o res-k10580_hs.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF21355 --match-only --taxon homo -o res-pf21355_domain_hs.faa
grep ">" res-pf21355_domain_hs.faa | grep -v _K > hs_PF21355_domain.txt
# remove leading ">" from hs_PF21355_domain.txt
# keep only NP_ sequences

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF21355 --match-only --taxon anthozoa -o res-pf21355_domain_cn.faa
grep ">" res-pf21355_domain_cn.faa | grep -v _K > cn_PF21355_domain.txt
# remove leading ">" from cn_PF21355_domain.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf21355_domain_cn.faa cn_PF21355_domain.txt > cn_PF21355_domain.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf21355_domain_hs.faa hs_PF21355_domain.txt > hs_PF21355_domain.faa

docker run --rm \
  --mount type=bind,source="$PWD",target=/work \
  ghcr.io/soedinglab/mmseqs2 \
  easy-cluster /work/cn_PF21355_domain.faa /work/cn_PF21355_domain /tmp \
  --min-seq-id 0.7 -c 0.8 --cov-mode 0
echo "Cluster Repr\tCluster Member" | cat - cn_PF21355_domain_cluster.tsv > cn_PF21355_domain_cluster.h.tsv
mv cn_PF21355_domain_cluster.h.tsv cn_PF21355_domain_cluster.tsv

# manually remove sequences < 80 AAs from cn_PF21355_domain_rep_seq.fasta

cat cn_PF21355_domain_rep_seq.fasta hs_PF21355_domain.faa > cn_hs_PF21355_domain.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_hs_PF21355_domain.faa -out /app/cn_hs_PF21355_domain.msa
~/iqtree-3.1.3-macOS/bin/iqtree3 -s cn_hs_PF21355_domain.msa -B 1000 --alrt 1000

# get loci

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF21355 --taxon anthozoa | grep -v _K |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.loci \
    --artifacts-dir res-pf21355
mv res-pf21355/loci.tsv cn_PF21355_loci.tsv
