      <column caption='Composite Rank' datatype='string' name='[Confidence, Feasibility, Interface (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Chemical Feasibility, Confidence, Interface (Combined)]' default='&quot;Other&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Likely&quot;'>
            <value>(&quot;High&quot;,true,&quot;Canonical&quot;)</value>
            <value>(&quot;High&quot;,true,&quot;Variant&quot;)</value>
          </bin>
          <bin default-name='false' value='&quot;Maybe&quot;'>
            <value>(&quot;High&quot;,false,&quot;Canonical&quot;)</value>
            <value>(&quot;High&quot;,false,&quot;Variant&quot;)</value>
            <value>(&quot;Medium&quot;,true,&quot;Canonical&quot;)</value>
            <value>(&quot;Medium&quot;,true,&quot;Variant&quot;)</value>
          </bin>
          <bin default-name='false' value='&quot;Stretch&quot;'>
            <value>(&quot;High&quot;,false,%null%)</value>
            <value>(&quot;High&quot;,false,&quot;Atypical&quot;)</value>
            <value>(&quot;High&quot;,true,%null%)</value>
            <value>(&quot;Low&quot;,true,%null%)</value>
            <value>(&quot;Low&quot;,true,&quot;Canonical&quot;)</value>
            <value>(&quot;Low&quot;,true,&quot;Variant&quot;)</value>
            <value>(&quot;Medium&quot;,false,&quot;Canonical&quot;)</value>
            <value>(&quot;Medium&quot;,false,&quot;Variant&quot;)</value>
            <value>(&quot;Medium&quot;,true,%null%)</value>
            <value>(&quot;Reject&quot;,true,&quot;Canonical&quot;)</value>
          </bin>
        </calculation>
