        <style-rule element='mark'>
          <encoding attr='color' field='[Confidence, Chemically Feasible, Candidate Interface (Combined)]' type='palette'>
            <map to='#59a14f'>
              <bucket>(&quot;High&quot;,true,&quot;Canonical&quot;)</bucket>
