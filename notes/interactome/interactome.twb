      <group caption='Feasibility &amp; Interface (Combined)' name='[Chemical Feasibility &amp; Interface (Combined)]' name-style='unqualified' user:ui-builder='nest-group'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[chemical feasibility]' />
          <groupfilter function='level-members' level='[interface]' />
        </groupfilter>
      </group>
      <group caption='Confidence, Feasibility, Interface' name='[Chemical Feasibility, Confidence, Interface (Combined)]' name-style='unqualified' user:ui-builder='nest-group'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[confidence]' />
          <groupfilter function='level-members' level='[chemical feasibility]' />
          <groupfilter function='level-members' level='[interface]' />
        </groupfilter>
      </group>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='shape' field='[Chemical Feasibility &amp; Interface (Combined)]' type='shape'>
            <map to=':filled/circle'>
              <bucket>(true,&quot;Canonical&quot;)</bucket>
            </map>
            <map to=':filled/diamond'>
              <bucket>(true,&quot;Variant&quot;)</bucket>
            </map>
            <map to=':filled/down-triangle'>
              <bucket>(true,%null%)</bucket>
            </map>
            <map to=':filled/times'>
              <bucket>(true,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='circle'>
              <bucket>(false,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='diamond'>
              <bucket>(false,&quot;Variant&quot;)</bucket>
            </map>
            <map to='down-triangle'>
              <bucket>(false,%null%)</bucket>
            </map>
            <map to='down-triangle'>
              <bucket>(false,&quot;None&quot;)</bucket>
            </map>
            <map to='square'>
              <bucket>(%null%,%null%)</bucket>
            </map>
            <map to='times'>
              <bucket>(false,&quot;Atypical&quot;)</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[Confidence, Feasibility, Interface (group)]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;Likely&quot;</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>&quot;Maybe&quot;</bucket>
            </map>
            <map to='#a2a2a2'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Stretch&quot;</bucket>
            </map>
          </encoding>
