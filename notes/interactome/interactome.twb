      </column>
      <column caption='Interface Family' datatype='string' name='[Calculation_0798931453603845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id (interactome_dd_faces.tsv)]: MAX(&#10;  IF [chain (interactome_dd_faces.tsv)] == &quot;A&quot; THEN [domain] ELSE NULL END&#10;)}&#10;  + &quot;-&quot; +&#10;{FIXED [fold_id (interactome_dd_faces.tsv)]: MAX(&#10;  IF [chain (interactome_dd_faces.tsv)] == &quot;B&quot; THEN [domain] ELSE NULL END&#10;)}' />
      </column>
      <column caption='Non-polar contacts per 100A2 buried' datatype='real' name='[Calculation_0798931454238726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*[nonpolar contacts]/[total buried surface area]' />
      </column>
      <column caption='Salt Bridge Heavy Atom Distance' datatype='real' name='[Calculation_0798931454504967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [salt bridge candidate heavy-atom distance min] == &quot;NA&quot;&#10;THEN 100&#10;ELSE&#10;    FLOAT([salt bridge candidate heavy-atom distance min])&#10;END' />
      </column>
      <column caption='Confidence' datatype='string' name='[Calculation_0798931454820360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pDockQ2 max] &lt; 0.23&#10;  THEN &quot;Reject&quot;&#10;ELSEIF [pDockQ2 max] &gt;= 0.70&#10;  THEN &quot;High&quot;&#10;ELSEIF [total buried surface area] &lt; 1000 AND&#10;       [pDockQ2 max] &gt;= 0.40&#10;  THEN &quot;Medium&quot;&#10;ELSEIF [pDockQ2 max] &gt;= 0.50&#10;  THEN &quot;Medium&quot;&#10;ELSE&#10;  &quot;Low&quot;&#10;END' />
      </column>
      <column caption='Is Hovering Artifact' datatype='boolean' name='[Calculation_0798931454959625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Calculation_0798931454238726] &lt;= 0.4 AND&#10; [interchain CA distance min] &gt; 4.5 AND&#10; [Calculation_0798931454504967] &gt; 4)&#10;OR&#10;[steric overlap candidates] &gt;= 3' />
      </column>
      <column caption='Is Cooperative Assembly' datatype='boolean' name='[Calculation_0798931455098890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total buried surface area] &gt;= 800 AND&#10;[total buried surface area] &lt; 1400 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;(([Calculation_0798931454238726] &gt; 0.45 AND&#10;  [salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_0798931454504967] &lt;= 4) OR&#10; [Calculation_0798931454238726] &gt; 0.70) AND&#10;[steric overlap candidates] &lt;= 1' />
      </column>
      <column caption='Is Electrostatic Salt Bridge Zipper' datatype='boolean' name='[Calculation_0798931455225867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total buried surface area] &gt;= 700 AND&#10;[total buried surface area] &lt; 1200 AND&#10;[total C/S contribution percent] &gt;= 25 AND&#10;[salt bridge candidates] &gt;= 2 AND&#10;[Calculation_0798931454504967] &lt;= 3 AND&#10;[nominal patch charge difference] &gt;= 3 AND&#10;[Calculation_0798931454238726] &gt; 0.2 AND&#10;[steric overlap candidates] &lt;= 1' />
      </column>
      <column caption='Is Homodimer Clamp' datatype='boolean' name='[Calculation_0798931455324172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total buried surface area] &gt;= 1800 AND&#10;[total C/S contribution percent] &gt;= 45 AND&#10;([Calculation_0798931454238726] &gt; 0.6 OR&#10; ([salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_0798931454504967] &lt;= 3.5)) AND&#10;[Calculation_0798931454238726] &gt; 0.5 AND&#10;[steric overlap candidates] &lt;= 2' />
      </column>
      <column caption='Is Hydrophobic Dominant' datatype='boolean' name='[Calculation_0798931455422477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total buried surface area] &gt;= 1000 AND&#10;[total buried surface area] &lt; 1800 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;[salt bridge candidates] &gt;= 0 AND&#10;[steric overlap candidates] &lt;= 2' />
      </column>
      <column caption='Is Lateral Cross-Strut' datatype='boolean' name='[Calculation_0798931455569934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[total buried surface area] &gt;= 500 AND&#10;[total buried surface area] &lt; 800 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;(([Calculation_0798931454238726] &gt; 0.25 AND&#10;  [salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_0798931454504967] &lt;= 4) OR&#10; [Calculation_0798931454238726] &gt; 0.70) AND&#10;[steric overlap candidates] &lt;= 1' />
      </column>
      <column caption='Chemically Feasible' datatype='boolean' name='[Calculation_0798931455754255]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0798931454959625] == FALSE AND&#10;([Calculation_0798931455569934] OR&#10; [Calculation_0798931455098890] OR&#10; [Calculation_0798931455225867] OR&#10; [Calculation_0798931455324172] OR&#10; [Calculation_0798931455422477])' />
      </column>
      <column caption='Is Face NA' datatype='boolean' name='[Calculation_0798931456065552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([candidate face],&quot;NA&quot;)' />
      </column>
      <column caption='Chain A Face' datatype='string' name='[Calculation_0798931459219474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id (interactome_dd_faces.tsv)],[patch_id (interactome_dd_faces.tsv)]: MAX(&#10;IF [chain (interactome_dd_faces.tsv)] == &quot;A&quot; THEN [candidate face] ELSE NULL END&#10;)}' />
      </column>
      <column caption='Chain A Protein Acc' datatype='string' name='[Calculation_0798931460423701]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;..&quot;+RIGHT([Chain A Sequence Name (copy)_0798931436421122],9)' />
      </column>
      <column caption='Sequence Feature' datatype='string' name='[Calculation_0798931461115929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Sequence Name],&quot; &quot;,2)' />
      </column>
      <column caption='Chain B Domain' datatype='string' name='[Chain A Domain (copy)_0798931460874264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id (interactome_dd_faces.tsv)],[patch_id (interactome_dd_faces.tsv)]: MAX(&#10;IF [chain (interactome_dd_faces.tsv)] == &quot;B&quot; THEN [domain] ELSE NULL END&#10;)}' />
