      <column caption='Chain B Face' datatype='string' name='[Chain A Face (copy)_0798931459395603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id (interactome_dd_faces.tsv)],[patch_id (interactome_dd_faces.tsv)]: MAX(&#10;IF [chain (interactome_dd_faces.tsv)] == &quot;B&quot; THEN [candidate face] ELSE NULL END&#10;)}' />
