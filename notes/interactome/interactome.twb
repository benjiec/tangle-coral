      <aliases enabled='yes' />
      <column caption='Chain A Protein Accession' datatype='string' name='[Calculation_3975215988830208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id]: MAX(&#10;  IF [chain] == &apos;A&apos; THEN [Protein Accession] ELSE NULL END&#10;)}' />
      </column>
      <column caption='Interface Type' datatype='string' name='[Calculation_3975215989600260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Chain A Protein Accession (copy)_3975215989440514]+&quot;-&quot;+[Chain A Domain (copy)_3975215989526531]' />
      </column>
      <column caption='Is Reference' datatype='boolean' name='[Calculation_3975215989977093]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [fold_id]: MAX(&#10;  IF STARTSWITH([Protein Accession], &quot;NP_&quot;) THEN TRUE ELSE FALSE END&#10;)}' />
      </column>
      <column caption='Normalized PAE' datatype='real' name='[Calculation_3975215997718534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [fold_id]: MIN([normalized PAE to partner])}' />
      </column>
      <column caption='Salt Bridge Heavy Atom Distance' datatype='real' name='[Calculation_3975215998210055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [salt bridge candidate heavy-atom distance min] == &quot;NA&quot;&#10;THEN 100&#10;ELSE&#10;    FLOAT([salt bridge candidate heavy-atom distance min])&#10;END' />
      </column>
      <column caption='Chain B Protein Acc' datatype='string' name='[Calculation_3975215999807497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;..&quot;+RIGHT([Chain A Protein Accession (copy)_3975215988932609],9)' />
      </column>
      <column caption='Sequence Feature' datatype='string' name='[Calculation_3975216000704523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Sequence Name],&quot; &quot;,2)' />
      </column>
      <column caption='Is Face NA' datatype='boolean' name='[Calculation_3975216003330062]' role='dimension' type='nominal'>
