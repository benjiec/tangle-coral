
sieve-py ~/git/tangle/sieve/scripts/merge-cluster-tsvs.py --output clusters.tsv clusters/*.tsv --cluster-fasta clusters/*_all_seqs.fasta

cut -f 1 sequence_death.tsv | grep -v Sequence\ Name |\
  sieve-py ~/git/tangle/sieve/scripts/alphafold-find.py \
    ../af_manifest.tsv - \
    --cross --max-chains 2 --max-unique-inputs 2 --highest |\
  sieve-py ~/git/tangle/sieve/scripts/alphafold-interface.py - \
    --domain-file sequence_death.tsv \
    --manifest ../af_manifest.tsv \
    --output interactome_death.tsv

cut -f 1 sequence_traf_slim.tsv | grep -v Sequence\ Name |\
  sieve-py ~/git/tangle/sieve/scripts/alphafold-find.py \
    ../af_manifest.tsv - \
    --cross --max-chains 6 --max-unique-inputs 2 --highest |\
  sieve-py ~/git/tangle/sieve/scripts/alphafold-interface.py - \
    --domain-file sequence_traf_slim.tsv \
    --manifest ../af_manifest.tsv \
    --output interactome_traf_slim.tsv

rm protein_names.tsv
cut -f 2 sequence_death.tsv | grep -v Protein | sieve-py ~/git/tangle/sieve/scripts/protein-names.py --allow-multiple - >> protein_names.tsv
cut -f 2 sequence_traf_slim.tsv | grep -v Protein | sieve-py ~/git/tangle/sieve/scripts/protein-names.py --allow-multiple - >> protein_names.tsv

