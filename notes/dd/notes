
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00531 \
  --sequence-source ncbi \
  --taxon anthozoa \
  -o res-pf00531.faa

tangle-py ../traf6/motifs.py res-pf00531.faa candidate_motifs.tsv

sieve-py ~/git/tangle/sieve/scripts/detected-extract-region.py res-pf00531.faa protein_pfam.tsv PF00531 1 1 dd.faa

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/res-pf00531.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/dd.faa /work/dd /tmp --min-seq-id 0.9 -c 0.9 --cov-mode 0
echo "Cluster Repr\tCluster Member" | cat - dd_cluster.tsv > dd_cluster.tsv.h
mv dd_cluster.tsv.h dd_cluster.tsv

