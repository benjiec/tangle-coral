          <datasource-dependencies datasource='federated.15h3xyz1q8ol311aqa2mz0opl99o'>
            <column caption='Input 1 has alpha7' datatype='boolean' name='[Calculation_1171934920630272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([interface structure 1],&quot;alpha7&quot;)' />
            </column>
            <column caption='Input has alpha7' datatype='boolean' name='[Calculation_1171934920867842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1171934920630272] OR [Input 1 has alpha 7 (copy)_1171934920736769]' />
