  <worksheets>
    <worksheet name='Grid'>
      <table>
        <view>
          <datasources>
            <datasource caption='dd_interactome.tsv+ (Multiple Connections)' name='federated.15h3xyz1q8ol311aqa2mz0opl99o' />
          </datasources>
          <datasource-dependencies datasource='federated.15h3xyz1q8ol311aqa2mz0opl99o'>
            <column caption='Input 1 Sequence Feature' datatype='string' name='[Calculation_0422414077009922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Sequence Name],&quot; &quot;,2)' />
            </column>
            <column caption='Normalized PAE' datatype='real' name='[Calculation_5394402189242368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([normalized PAE 1 to 2],[normalized PAE 2 to 1])' />
            </column>
            <column caption='Non-polar contacts per 100A2 buried' datatype='real' name='[Calculation_5394402190839809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*[nonpolar contacts]/[total buried surface area]' />
            </column>
            <column caption='Salt Bridge Heavy Atom Distance' datatype='real' name='[Calculation_5394402191409154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [salt bridge candidate heavy-atom distance min] == &quot;NA&quot;&#10;THEN 100&#10;ELSE&#10;    FLOAT([salt bridge candidate heavy-atom distance min])&#10;END' />
            </column>
            <column caption='Chemically Feasible' datatype='boolean' name='[Calculation_5394402207596548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Chemically Feasible (copy)_5394402491187207] == FALSE AND&#10;([Is Electrostatic Salt Bridge Zipper (copy)_5394402494124043] OR&#10; [Is Cooperative Lateral Cross-Strut (copy)_5394402503229453] OR&#10; [Is Homodimer Clamp (copy)_5394402493349898] OR&#10; [Is Hydrophobic Dominant (copy)_5394402492452873] OR&#10; [Is Hovering Artifact (copy)_5394402491953160])' />
            </column>
            <column caption='Confidence' datatype='string' name='[Calculation_5394402209005573]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pDockQ2 max] &lt; 0.23&#10;  THEN &quot;Reject&quot;&#10;ELSEIF [pDockQ2 max] &gt;= 0.70&#10;  THEN &quot;High&quot;&#10;ELSEIF [total buried surface area] &lt; 1000 AND&#10;       [pDockQ2 max] &gt;= 0.40&#10;  THEN &quot;Medium&quot;&#10;ELSEIF [pDockQ2 max] &gt;= 0.50&#10;  THEN &quot;Medium&quot;&#10;ELSE&#10;  &quot;Low&quot;&#10;END' />
            </column>
            <column caption='Interface Family' datatype='string' name='[Calculation_5394402478870534]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Protein], &quot;NP_&quot;)&#10;  THEN &quot;hs &quot;+[domain 1]+&quot;-&quot;+[domain 2]&#10;ELSE&#10;  [domain 1]+&quot;-&quot;+[domain 2]&#10;END' />
            </column>
            <column caption='Is Hovering Artifact' datatype='boolean' name='[Chemically Feasible (copy)_5394402491187207]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Calculation_5394402190839809] &lt;= 0.4 AND&#10; [interchain CA distance min] &gt; 4.5 AND&#10; [Calculation_5394402191409154] &gt; 4)&#10;OR&#10;[steric overlap candidates] &gt;= 3' />
            </column>
            <column caption='Input 2 Sequence Feature' datatype='string' name='[Input 1 Sequence Feature (copy)_0422414077612035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Sequence Name (dd_proteins.tsv1)],&quot; &quot;,2)' />
            </column>
            <column caption='Is Cooperative Assembly' datatype='boolean' name='[Is Cooperative Lateral Cross-Strut (copy)_5394402503229453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total buried surface area] &gt;= 800 AND&#10;[total buried surface area] &lt; 1400 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;(([Calculation_5394402190839809] &gt; 0.45 AND&#10;  [salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_5394402191409154] &lt;= 4) OR&#10; [Calculation_5394402190839809] &gt; 0.70) AND&#10;[steric overlap candidates] &lt;= 1' />
            </column>
            <column caption='Is Lateral Cross-Strut' datatype='boolean' name='[Is Electrostatic Salt Bridge Zipper (copy)_5394402494124043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total buried surface area] &gt;= 500 AND&#10;[total buried surface area] &lt; 800 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;(([Calculation_5394402190839809] &gt; 0.25 AND&#10;  [salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_5394402191409154] &lt;= 4) OR&#10; [Calculation_5394402190839809] &gt; 0.70) AND&#10;[steric overlap candidates] &lt;= 1' />
            </column>
            <column caption='Is Electrostatic Salt Bridge Zipper' datatype='boolean' name='[Is Homodimer Clamp (copy)_5394402493349898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total buried surface area] &gt;= 700 AND&#10;[total buried surface area] &lt; 1200 AND&#10;[total C/S contribution percent] &gt;= 25 AND&#10;[salt bridge candidates] &gt;= 2 AND&#10;[Calculation_5394402191409154] &lt;= 3 AND&#10;[nominal patch charge difference] &gt;= 3 AND&#10;[Calculation_5394402190839809] &gt; 0.2 AND&#10;[steric overlap candidates] &lt;= 1' />
            </column>
            <column caption='Is Hydrophobic Dominant' datatype='boolean' name='[Is Hovering Artifact (copy)_5394402491953160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total buried surface area] &gt;= 1000 AND&#10;[total buried surface area] &lt; 1800 AND&#10;[total C/S contribution percent] &gt;= 40 AND&#10;[salt bridge candidates] &gt;= 0 AND&#10;[steric overlap candidates] &lt;= 2' />
            </column>
            <column caption='Is Homodimer Clamp' datatype='boolean' name='[Is Hydrophobic Dominant (copy)_5394402492452873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[total buried surface area] &gt;= 1800 AND&#10;[total C/S contribution percent] &gt;= 45 AND&#10;([Calculation_5394402190839809] &gt; 0.6 OR&#10; ([salt bridge candidates] &gt;= 1 AND&#10;  [Calculation_5394402191409154] &lt;= 3.5)) AND&#10;[Calculation_5394402190839809] &gt; 0.5 AND&#10;[steric overlap candidates] &lt;= 2' />
            </column>
            <column caption='Input 2 Protein Accession' datatype='string' name='[Protein (dd_proteins.tsv1)]' role='dimension' type='nominal' />
            <column caption='Input 1 Protein Accession' datatype='string' name='[Protein]' role='dimension' type='nominal' />
            <column caption='Input 2 Sequence Name' datatype='string' name='[Sequence Name (dd_proteins.tsv1)]' role='dimension' type='nominal' />
            <column caption='Input 1 Sequence Name' datatype='string' name='[Sequence Name]' role='dimension' type='nominal' />
            <column caption='Face 1' datatype='string' name='[candidate face 1]' role='dimension' type='nominal' />
