      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[Chemically Feasible, Confidence, Interface (Combined)]' type='palette'>
            <map to='#59a14f'>
              <bucket>(&quot;High&quot;,true,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>(&quot;High&quot;,true,&quot;Variant&quot;)</bucket>
