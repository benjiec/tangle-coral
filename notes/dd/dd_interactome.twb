            <map to='#8cd17d'>
              <bucket>(&quot;High&quot;,false,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;High&quot;,false,&quot;Variant&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;High&quot;,true,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;Medium&quot;,true,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;Medium&quot;,true,&quot;Variant&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;Plausible&quot;,true,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='#8cd17d'>
              <bucket>(&quot;Plausible&quot;,true,&quot;Variant&quot;)</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>(&quot;Medium&quot;,false,&quot;NA&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Low&quot;,false,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Low&quot;,false,&quot;Canonical&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Low&quot;,false,&quot;NA&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Low&quot;,false,&quot;Variant&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Low&quot;,true,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Medium&quot;,false,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Plausible&quot;,false,&quot;Atypical&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Plausible&quot;,false,&quot;NA&quot;)</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>(&quot;Reject&quot;,false,&quot;Atypical&quot;)</bucket>
