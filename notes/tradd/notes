
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF09034 PF00531 \
  --ordered \
  --sequence-source ncbi \
  --taxon anthozoa \
  -o res-pf09034_pf00531.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF20694 PF00531 \
  --ordered \
  --sequence-source ncbi \
  --taxon anthozoa \
  -o res-pf20694_pf00531.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF20694 PF00531 \
  --ordered \
  --sequence-source ncbi \
  --taxon homo \
  -o res-pf20694_pf00531_hs.faa


cat res-pf09034_pf00531.faa res-pf20694_pf00531.faa res-pf20694_pf00531_hs.faa > x.faa

tangle-py ../traf6/motifs.py x.faa candidate_motifs.tsv

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/x.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv

