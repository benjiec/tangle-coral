sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K05410 --taxon "Homo sapiens" -o hs_K05410.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF18397 --taxon cnidaria |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.nothing \
    --artifacts-dir res-pf18397

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF18394 --taxon cnidaria |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.nothing \
    --artifacts-dir res-pf18394

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF16516 --taxon cnidaria |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.nothing \
    --artifacts-dir res-pf16516

# create PF18397 and PF18394 lists from Tableau, based on domain architecture
#
# remove sequences that are similar/isoforms

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf18397/sequences.faa cn_PF18397.txt > cn_PF18397.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf18394/sequences.faa cn_PF18394.txt > cn_PF18394.faa

# add human references to new faa files

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_PF18397_hs_ref.faa -out /app/cn_PF18397_hs_ref.msa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_PF18394_hs_ref.faa -out /app/cn_PF18394_hs_ref.msa

~/iqtree-3.1.3-macOS/bin/iqtree3 -s cn_PF18397_hs_ref.msa -B 1000 --alrt 1000
~/iqtree-3.1.3-macOS/bin/iqtree3 -s cn_PF18394_hs_ref.msa -B 1000 --alrt 1000


# protein names
python3 ~/git/tangle/sieve/scripts/protein-names.py cn_PF18397.txt


# make a full list for HMM threshold testing

cat cn_PF18397.faa cn_PF18394.faa > cn_IKK.faa


# PF18394 HMM - TBK1-like

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_PF18394.faa -out /app/TBK1-like_anthozoa.msa
hmmbuild TBK1-like_anthozoa.hmm TBK1-like_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm TBK1-like_anthozoa.hmm \
  --positive-fasta cn_PF18394.faa \
  --all-fasta cn_IKK.faa \
  --output x_tbk1

# PF18397 HMM - IKK-like

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_PF18397.faa -out /app/IKK-like_anthozoa.msa
hmmbuild IKK-like_anthozoa.hmm IKK-like_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IKK-like_anthozoa.hmm \
  --positive-fasta cn_PF18397.faa \
  --all-fasta cn_IKK.faa \
  --output x_ikk


# bTrCP

sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K03362 --taxon anthozoa |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.nothing \
    --artifacts-dir res-k03362

sieve-py ~/git/tangle/sieve/scripts/ko-find-matches.py K10260 --taxon anthozoa |
  PYTHONPATH=~/git/tangle/coral sieve-py ~/git/tangle/sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.generic.nothing \
    --artifacts-dir res-k10260

# separately, cn_K03362 and combined cn_K03362_K10260, removing elongated
# proteins from both sets as they should not count as positives or negatives

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-k03362/sequences.faa cn_K03362.txt > cn_K03362.faa
tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-k10260/sequences.faa cn_K03362_K10260.txt > cn_K10260.faa

cat cn_K03362.faa cn_K10260.faa > cn_K03362_K10260.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_K03362.faa -out /app/BTRC_anthozoa.msa
hmmbuild BTRC_anthozoa.hmm BTRC_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm BTRC_anthozoa.hmm \
  --positive-fasta cn_K03362.faa \
  --all-fasta cn_K03362_K10260.faa \
  --output x_btrc
