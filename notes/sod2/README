    --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
    --artifacts-dir res-sp_ctp_MnFeSOD_algae \
    --ko-hmm assets/k04564.hmm \
    --pfam-hmm assets/pfam.hmm \
    --fasta transcripts_PM32_PM34.faa

PYTHONPATH=../coral python3 ../sieve/scripts/build-fasta-artifacts.py \
    --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
    --artifacts-dir res-sp_ctp_MnFeSOD_algae \
    --ko-hmm assets/k04564.hmm \
    --pfam-hmm assets/pfam.hmm \
    --fasta transcripts_PM31.faa

PYTHONPATH=../coral python3 ../sieve/scripts/build-fasta-artifacts.py \
    --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
    --artifacts-dir res-sp_ctp_MnFeSOD_algae \
    --ko-hmm assets/k04564.hmm \
    --pfam-hmm assets/pfam.hmm \
    --fasta transcripts_PM35.faa

PYTHONPATH=../coral python3 ../sieve/scripts/build-fasta-artifacts.py \
    --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
    --artifacts-dir res-sp_ctp_MnFeSOD_algae \
    --ko-hmm assets/k04564.hmm \
    --pfam-hmm assets/pfam.hmm \
    --fasta transcripts_PM36.faa

PYTHONPATH=../coral python3 ../sieve/scripts/check-artifacts-by-rules.py \
  --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
  --artifacts-dir res-sp_ctp_MnFeSOD_algae \
  --hmm-dir assets \
  --pfam-hmm assets/pfam.hmm \
  --ko-hmm assets/k04564.hmm \
  --ko-thresholds assets/k04564_threshold.tsv \
  --deeploc-csv res-sp_ctp_MnFeSOD_algae.deeploc.csv

../sieve/scripts/rule-results-to-fasta.py \
  --artifacts-dir res-sp_ctp_MnFeSOD_algae \
  --output sp_ctp_MnFeSOD_algae_all.faa

python3 ../sieve/scripts/fasta-unique-sequences.py sp_ctp_MnFeSOD_algae_all.faa sp_ctp_MnFeSOD_algae.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/sp_ctp_MnFeSOD_algae.faa -out /app/sp_ctp_MnFeSOD_algae.msa
hmmbuild sp_ctp_MnFeSOD_algae.hmm sp_ctp_MnFeSOD_algae.msa

PYTHONPATH=../coral sieve-py ../sieve/scripts/hmmsearch-threshold.py \
  --hmm sp_ctp_MnFeSOD_algae.hmm \
  --artifacts-dir res-sp_ctp_MnFeSOD_algae \
  --output sp_ctp_MnFeSOD_algae_thresholds.tsv



# Model Analysis

## Generating Mature Sequences of the Catalytic Region

Run the following for each group, to generate bounded mature protein sequences

sieve-py ../sieve/scripts/bound-fasta-by-hmms.py \
  --n-hmm assets/pf00081.hmm \
  --c-hmm assets/pf02777.hmm \
  --fasta mt_MnSOD_cnidaria.faa --n-position 3 --c-position 100 --acc-desc mT_cnidaria > mt_MnSOD_cnidaria_mature.faa

And for the reference

sieve-py ../sieve/scripts/bound-fasta-by-hmms.py \
  --n-hmm assets/pf00081.hmm \
  --c-hmm assets/pf02777.hmm \
  --fasta reference.faa --n-position 3 --c-position 100 > reference_mature.faa

Generate .hmm profiles for each category's mature sequences, e.g. mt_MnSOD_cnidaria_mature.hmm


## Sequence Concordance and Evolutionary Clades

Combined the mature.faa files into sod_tree_all.faa, then cluster

docker run --rm \
  --mount type=bind,source="$PWD",target=/work \
  ghcr.io/soedinglab/mmseqs2 \
  easy-cluster /work/sod_tree_all.faa /work/sod_tree_all.faa /tmp \
  --min-seq-id 0.98 -c 0.9 --cov-mode 0 --cluster-mode 2

mv sod_tree_all.faa_rep_seq.fasta sod_tree.faa
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/sod_tree.faa -out /app/sod_tree.msa

Then run iqtree

~/iqtree-3.1.3-macOS/bin/iqtree3 -s sod_tree.msa -B 1000 --alrt 1000

The .contree or .treefile can be visualized at https://itol.embl.de/upload.cgi

HMM search on the above sod_tree.faa file generated sod_tree-mature_hmm.tsv

hmmsearch --domtblout sod_tree-mature_hmm.txt ~/git/tangle/play/assets/sod_mature_all.hmm sod_tree.faa
python3 ../../../sieve/scripts/domtbl-tsv.py sod_tree-mature_hmm.txt > sod_tree-mature_hmm.tsv


# Summarize Sequences and Taxonomy

Use the following to generate a summary.tsv that can be joined with genomes.tsv

sieve-py ../../../sieve/scripts/summarize-artifacts.py  \
  --artifacts-dir res-mt_MnSOD_cnidaria \
  --category mt_cnidaria \
  --hmm ../../profiles/mt_MnSOD_cnidaria_mature.hmm \
  --output summary.tsv

sieve-py ../../../sieve/scripts/summarize-artifacts.py \
  --artifacts-dir res-sp_MnSOD_cnidaria \
  --category sp_cnidaria \
  --hmm ../../profiles/sp_MnSOD_cnidaria_mature.hmm \
  --output summary.tsv

sieve-py ../../../sieve/scripts/summarize-artifacts.py \
  --artifacts-dir res-sp_ctp_MnFeSOD_algae \
  --category sp_ctp_algae \
  --hmm ../../profiles/sp_ctp_MnFeSOD_algae_mature.hmm \
  --output summary.tsv

sieve-py ../../../sieve/scripts/summarize-artifacts.py \
  --artifacts-dir res-sp_MnFeSOD_algae \
  --category sp_algae \
  --hmm ../../profiles/sp_MnFeSOD_algae_mature.hmm \
  --output summary.tsv
