  --rule coral.rules.sp_MnSOD_cnidaria.rule_tangle_curated \
  --artifacts-dir res-sp_MnSOD_cnidaria \
  --pfam-hmm assets/pfam.hmm \
  --ko-hmm assets/k04564.hmm \
  --ko-thresholds assets/k04564_threshold.tsv \
  --deeploc-csv res-sp_MnSOD_cnidaria.deeploc.csv

../sieve/scripts/rule-results-to-fasta.py \
  --artifacts-dir res-sp_MnSOD_cnidaria \
  --output sp_MnSOD_cnidaria_all.faa

python3 ../sieve/scripts/fasta-unique-sequences.py sp_MnSOD_cnidaria_all.faa sp_MnSOD_cnidaria.faa
