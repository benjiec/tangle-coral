## sp_ctp_MnFeSOD (can modify for sp_MnFeSOD)

python3 ../sieve/scripts/ko-find-matches.py K04564 --taxon symbiodiniaceae | \
  PYTHONPATH=../coral python3 ../sieve/scripts/build-protein-artifacts.py \
    --rule coral.rules.sp_ctp_MnFeSOD_algae.rule \
