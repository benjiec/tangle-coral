            <column caption='Lowest E-value Rank' datatype='integer' name='[Calculation_0036393756078080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [query_accession (protein_ko_assigned.tsv)],&#10;       [query_database (protein_ko_assigned.tsv)]: MIN(&#10;&#10;IF [bitscore (protein_ko_assigned.tsv)] &gt;= [bitscore_threshold (protein_ko_assigned.tsv)]&#10;THEN INT([custom_metric_value (protein_ko_assigned.tsv)])&#10;ELSE NULL END&#10;)}' />
            </column>
            <column caption='Match Length' datatype='integer' name='[Calculation_1310520663515136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[query_end (protein_pfam.tsv1)]-[query_start (protein_pfam.tsv1)]+1' />
            </column>
            <column caption='Assigned KO' datatype='string' name='[Calculation_1318698290372608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [query_accession],[query_database]: MAX(&#10;&#10;IF INT([custom_metric_value (protein_ko_assigned.tsv)]) == [Calculation_0036393756078080]&#10;THEN [target_accession (protein_ko_assigned.tsv)]&#10;ELSE NULL END&#10;&#10;)}' />
