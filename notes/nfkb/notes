# find all Cnidaria PF00554 containing sequences
sieve-py ../sieve/scripts/pfam-find-matches.py PF00554 \
  --taxon cnidaria \
  -o cn_PF00554.faa

# Generate PF00554 MSA
sieve-py ../sieve/scripts/pfam-find-matches.py PF00554 \
  --taxon cnidaria \
  --match-only \
  -o cn_PF00554_pf.faa

sieve-py ../sieve/scripts/pfam-find-matches.py PF00554 \
  --taxon "Homo sapiens" \
  --match-only \
  -o hs_PF00554_pf.faa

# Generate PF16179 MSA
sieve-py ../sieve/scripts/pfam-find-matches.py PF16179 \
  --taxon cnidaria \
  --match-only \
  -o cn_PF16179_pf.faa

sieve-py ../sieve/scripts/pfam-find-matches.py PF16179 \
  --taxon "Homo sapiens" \
  --match-only \
  -o hs_PF16179_pf.faa

# Running MSA
docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/x.faa -out /app/x.msa

# Building HMM profiles

hmmbuild p100-like_anthozoa.hmm p100-like_anthozoa.msa
hmmbuild p52-like_anthozoa.hmm p52-like_anthozoa.msa

PYTHONPATH=../coral sieve-py ../sieve/scripts/hmmsearch-threshold.py \
  --hmm p100-like_anthozoa.hmm \
  --positive-fasta p100-like_anthozoa.faa \
  --all-fasta cn_PF00554.faa \
  --output p100-like_anthozoa_thresholds.tsv

PYTHONPATH=../coral sieve-py ../sieve/scripts/hmmsearch-threshold.py \
  --hmm p52-like_anthozoa.hmm \
  --positive-fasta p52-like_anthozoa.faa \
  --all-fasta cn_PF00554.faa \
  --output p52-like_anthozoa_thresholds.tsv
