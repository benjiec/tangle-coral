
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00531 PF00069 \
  --ordered \
  --sequence-source ncbi \
  --taxon anthozoa \
  -o res-pf00531_pf00069.faa

sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF00531 PF00069 \
  --ordered \
  --sequence-source ncbi \
  --taxon homo \
  -o res-pf00531_pf00069_hs.faa

cat res-pf00531_pf00069.faa res-pf00531_pf00069_hs.faa > x.faa

tangle-py ../traf6/motifs.py x.faa candidate_motifs.tsv

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/x.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv

rm x.faa

# manually inspect Anthozoa sequences and remove those that do not look like
# DED-DD-PKinase, and remove duplicates from same locus, save into cn_RAK.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf00531_pf00069.faa cn_IRAK.txt > cn_IRAK.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_IRAK.faa -out /app/IRAK_anthozoa.msa

hmmbuild IRAK_anthozoa.hmm IRAK_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IRAK_anthozoa.hmm \
  --positive-fasta cn_IRAK.faa \
  --all-fasta res-pf00531_pf00069.faa \
  --output x
