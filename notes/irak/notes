
sieve-py ~/git/tangle/sieve/scripts/pfam-find-matches.py PF01335 --taxon anthozoa -o res-pf01335.faa

# manually inspect remaining sequences and remove those that do not look like
# DED-DD-PKinase, and remove duplicates from same locus, save into
# cn_IRAK.txt

tangle-py ~/git/tangle/tangle/scripts/fasta-emit.py res-pf01335.faa cn_IRAK.txt > cn_IRAK.faa

docker run --platform linux/amd64 --rm -v .:/app pegi3s/muscle -in /app/cn_IRAK.faa -out /app/IRAK_anthozoa.msa

hmmbuild IRAK_anthozoa.hmm IRAK_anthozoa.msa

sieve-py ~/git/tangle/sieve/scripts/hmmsearch-threshold.py \
  --hmm IRAK_anthozoa.hmm \
  --positive-fasta cn_IRAK.faa \
  --all-fasta res-pf01335.faa \
  --output x

tangle-py ../cd40/motifs.py cn_IRAK.faa candidate_motifs.tsv

docker run --rm -v .:/work ghcr.io/soedinglab/mmseqs2 easy-cluster /work/cn_IRAK.faa /work/candidate /tmp
echo "Cluster Repr\tCluster Member" | cat - candidate_cluster.tsv > candidate_cluster.tsv.h
mv candidate_cluster.tsv.h candidate_cluster.tsv
rm candidate_*.fasta
